Meta.DisplayName=Jupiter Bot
Meta.Description=Jupiter Bot administration client. It connects out to a game server and to IRC. It is not part of the game instance.
Meta.OS=Windows, Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=egtechgeek,fffreak9999
Meta.URL=https://github.com/JAJames/Jupiter-Bot
Meta.DisplayImageSource=
Meta.EndpointURIFormat= 
Meta.ConfigManifest=jupiter-botconfig.json
Meta.MetaConfigManifest=jupiter-botmetaconfig.json
Meta.ConfigRoot=jupiter-bot.kvp
Meta.MinAMPVersion=2.6.5.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=Linux runs the published Windows build under Wine. The prefix needs the Visual C++ 2019 runtime and OpenSSL 1.1. A container supplies those without installing them on the host. Windows runs Bot.exe directly.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.AppConfigId=58eac3a1-c6dc-4fb6-8b9b-ccb6df5d5661
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial Jupiter Bot template. Default connection is a Renegade X server on port 7777. Linux installs the Visual C++ 2019 runtime and OpenSSL 1.1. On Windows, install that runtime and place libssl-1_1-x64.dll and libcrypto-1_1-x64.dll next to Bot.exe.
Meta.BreakingReleaseNotes=
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Jupiter Bot
App.RootDir=./jupiter-bot/
App.BaseDirectory=./jupiter-bot/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=Bot.exe
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=jupiter-bot
App.LinuxCommandLineArgs=Bot.exe
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} -config Config.ini -pluginsdir Plugins -configsdir Configs
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=?
App.ExitMethod=OS_CLOSE
App.ExitTimeout=15
App.ExitString=exit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[jupiter-botports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=0
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=0
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.TailLogFilePath=
App.UpdateSources=@IncludeJson[jupiter-botupdates.json]
App.PreStartStages=@IncludeJson[jupiter-botstart.json]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=^{{$WineBaseDir}}Bot\.exe.*$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
